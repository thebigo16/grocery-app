rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /households/{hid} {
      // Members can read their household; queries use array-contains on uid.
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Anyone signed in can start a household that contains only themselves.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];
      // Members can rename the household.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      // Joining with an invite link: the only change is adding yourself.
      // The household id is a long random string shared only by invite.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && resource.data.members.size() < 6;

      // Everything inside a household (items, pantry, recipes, settings).
      match /{sub=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
